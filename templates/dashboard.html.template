          <th style="padding:6px 8px;text-align:left;color:var(--text-muted);font-weight:600;">改寫後第一句</th>
          <th style="padding:6px 8px;text-align:left;color:var(--text-muted);font-weight:600;">對應懶人包</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
  c.appendChild(summary);

  // Full script cards
  SCRIPTS.forEach(s => {
    const d = document.createElement('div');
    d.className = 'script-card';
    const firstLine = (s.script.match(/(?:【口白逐字稿】\s*\n*)([^\n]+)/) || ['',''])[1].trim();
    const charCount = firstLine.replace(/[，。！？、—\s]/g,'').length;
    d.innerHTML = `<h3>🎬 腳本 ${s.n}｜原貼文：@${s.author} · ${s.likes}讚</h3>
      <div class="script-meta">
        <span class="script-badge sb-pack">🎁 ${s.pack}</span>
        <span class="script-badge sb-dur">⏱️ ${s.duration}</span>
        ${s.hookType ? `<span class="script-badge" style="background:#1a1a2e;color:#e879f9;border:1px solid #7e22ce">🎯 ${s.hookType}</span>` : (s.hookStyle ? `<span class="script-badge" style="background:#1a1a2e;color:#e879f9;border:1px solid #7e22ce">${s.hookStyle}</span>` : '')}
        ${s.reason ? `<span class="script-badge sb-reason">💡 ${s.reason}</span>` : ''}
      </div>
      ${s.hookFormula ? `<div style="background:#1a1a2e;border-left:3px solid #fbbf24;border-radius:6px;padding:10px 14px;margin:8px 0 4px;font-size:0.85rem;">
        <div style="color:#a78bfa;font-size:0.72rem;margin-bottom:4px;font-weight:600;">📋 套用模板</div>
        <div style="color:#fbbf24;font-family:monospace;">「${s.hookFormula}」</div>
      </div>` : ''}
      ${firstLine ? `<div style="background:#0a1a14;border-left:3px solid #22d3ee;border-radius:6px;padding:10px 14px;margin:8px 0 10px;font-size:0.9rem;">
        <div style="color:#22d3ee;font-size:0.72rem;margin-bottom:4px;font-weight:600;">🎤 改寫後第一句（${charCount} 字）</div>
        <div style="color:#cdd9e5;font-weight:600;">${firstLine}</div>
      </div>` : ''}
      <div class="script-body">${s.script}</div>
      <div style="margin-top:8px;font-size:0.72rem;color:#666">原貼文：<a href="${s.url}" target="_blank" style="color:#a78bfa">${s.url}</a></div>`;
    c.appendChild(d);
  });
}


function renderSuggestions() {
  const c = document.getElementById('suggestions-container');
  if (!c) return;
  SUGGESTIONS.forEach(s => {
    const d = document.createElement('div');
    d.className = 'script-card';
    const stars = '★'.repeat(s.stars) + '☆'.repeat(5 - s.stars);
    d.innerHTML = `<h3>🎁 建議 ${s.n}｜${s.name}</h3>
      <div class="script-meta">
        <span class="script-badge" style="background:#1a1a2e;color:#fbbf24;border:1px solid #b45309">${s.tier}</span>
        <span class="script-badge" style="background:#0a0a0a;color:#fbbf24;border:1px solid #92400e">${stars}</span>
      </div>
      <div style="font-size:0.82rem;line-height:1.7;color:#cdd9e5;padding:6px 4px 0;">
        <div style="margin-bottom:8px"><span style="color:#a78bfa">📊 Threads 證據：</span>${s.evidence}</div>
        <div style="margin-bottom:8px"><span style="color:#34d399">🧩 補哪個缺口：</span>${s.gap}</div>
        <div style="margin-bottom:8px"><span style="color:#f472b6">🎣 廣告鉤子方向：</span>${s.hook}</div>
        <div><span style="color:#fbbf24">💰 漏斗潛力：</span>${s.potential}</div>
      </div>`;
    c.appendChild(d);
  });
}


function renderVideoHooks() {
  const c = document.getElementById('video-hooks-container');
  if (!c) return;
  VIDEO_HOOKS.forEach((v, i) => {
    const d = document.createElement('div');
    d.className = 'script-card';
    d.innerHTML = `<h3>📹 鉤子 ${i+1}｜@${v.author} · ${v.likes}讚</h3>
      <div class="script-meta">
        <span class="script-badge" style="background:#1a1a2e;color:#22d3ee;border:1px solid #0e7490">${v.group} ${v.group_name}</span>
      </div>
      <div style="background:#0a0f14;padding:14px 16px;border-left:3px solid #fbbf24;border-radius:6px;margin:8px 0 10px;font-size:0.95rem;line-height:1.6;color:#fbbf24;font-weight:600;">
        ${v.first}
      </div>
      <div style="font-size:0.78rem;line-height:1.7;color:#9ca3af;">
        <div style="margin-bottom:4px"><span style="color:#a78bfa">📝 完整 hook：</span>${v.hook}</div>
        <div style="margin-bottom:4px"><span style="color:#34d399">📋 套用模板：</span><span style="color:#cdd9e5;font-family:monospace">${v.template}</span></div>
        <div style="font-size:0.72rem;color:#f87171;margin-top:6px;">${v.note || ''}</div>
      </div>
      <div style="margin-top:10px;font-size:0.72rem;"><a href="${v.url}" target="_blank" style="color:#a78bfa">→ 看原貼文影片</a></div>`;
    c.appendChild(d);
  });
}


function renderHookLib() {
  const c = document.getElementById('hook-lib-container');
  if (!c) return;
  HOOK_LIB.forEach(cat => {
    const d = document.createElement('div');
    d.className = 'script-card';
    let items = cat.items.map(it => `<li style="margin-bottom:5px;padding-left:6px;border-left:2px solid ${cat.color};color:#cdd9e5;font-size:0.85rem;line-height:1.55;">${it}</li>`).join('');
    d.innerHTML = `<h3 style="color:${cat.color};">${cat.category}（${cat.items.length} 個）</h3>
      <ul style="list-style:none;padding:8px 0 0;margin:0;">${items}</ul>`;
    c.appendChild(d);
  });
}

let currentGroup = 'all', currentSort = 'likes', currentDays = 17, currentLikes = 1000;

function daysSince(dateStr) {
  const snap = new Date(DATA.snapshot_date);
  const post = new Date(dateStr);
  return Math.floor((snap - post) / 86400000);
}

function applyFilter() {
  let items = [...DATA.candidates];
  if(currentGroup !== 'all') items = items.filter(p => p.group === currentGroup);
  items = items.filter(p => p.likes >= currentLikes);
  items = items.filter(p => daysSince(p.date) <= currentDays);
  if(currentSort === 'likes') items.sort((a,b) => b.likes - a.likes);
  else if(currentSort === 'score') items.sort((a,b) => b.imitate_score - a.imitate_score);
  else if(currentSort === 'date') items.sort((a,b) => b.date.localeCompare(a.date));
  renderCards(items);
  document.getElementById('stat-total').textContent = items.length;
  document.getElementById('stat-hot').textContent = items.filter(p=>p.likes>=1800).length;
  document.getElementById('stat-score5').textContent = items.filter(p=>p.imitate_score===5).length;
}

function toggleAbout() {
  const panel = document.getElementById('about-panel');
  const arrow = document.getElementById('about-arrow');
  const open = panel.classList.toggle('open');
  arrow.textContent = open ? '▲ 收起' : '▼ 展開';
}

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentGroup = btn.dataset.group;
    applyFilter();
  });
});
document.querySelectorAll('.sort-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentSort = btn.dataset.sort;
    applyFilter();
  });
});

const slider = document.getElementById('likes-slider');
const likesVal = document.getElementById('likes-val');
slider.addEventListener('input', () => {
  currentLikes = parseInt(slider.value);
  likesVal.textContent = currentLikes.toLocaleString();
  applyFilter();
});

document.querySelectorAll('#date-btns button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#date-btns button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentDays = parseInt(btn.dataset.days);
    applyFilter();
  });
});

applyFilter();
renderScripts();
renderSuggestions();
renderHookLib();
renderVideoHooks();
</script>
