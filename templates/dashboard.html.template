function fmt(n) { if(!n) return '-'; if(n>=10000) return (n/10000).toFixed(1)+'萬'; return n.toLocaleString(); }

function renderCards(items) {
  const c = document.getElementById('cards-container');
  c.innerHTML = '';
  items.forEach(p => {
    const div = document.createElement('div');
    div.className = `card ${scoreColors[p.imitate_score]||''}`;
    div.dataset.group = p.group;
    div.innerHTML = `
      <div class="card-header">
        <div class="avatar">${p.author[0].toUpperCase()}</div>
        <div class="author-info">
          <div class="author-name">
            @${p.author}
            ${p.verified ? '<span class="verified">✓ 已驗證</span>' : ''}
          </div>
          <div class="author-meta">${p.date} · ${p.group} ${p.group_name}</div>
        </div>
        <div class="likes-big">❤️ ${fmt(p.likes)}</div>
      </div>
      <div class="hook">${p.hook}</div>
      <div class="summary">${p.summary}</div>
      <div class="tags">
        <span class="tag tag-group ${groupColors[p.group]||''}">${p.group} ${p.group_name}</span>
        <span class="tag tag-hook">🎣 ${p.hook_type}</span>
        ${p.is_new ? '<span class="tag tag-new">🆕 今日新增</span>' : ''}
        ${p.is_rising ? `<span class="tag tag-rising">📈 +${p.delta_pct}%</span>` : ''}
        ${p.has_pack ? '<span class="tag tag-pack">📦 有懶人包CTA</span>' : ''}
        ${p.has_video ? '<span class="tag tag-video">🎥 有影片</span>' : ''}
      </div>
      <div class="metrics">
        <div class="metric"><span class="metric-icon">❤️</span><span class="metric-val">${fmt(p.likes)}</span><span class="metric-label">讚</span></div>
        ${p.comments ? `<div class="metric"><span class="metric-icon">💬</span><span class="metric-val">${fmt(p.comments)}</span><span class="metric-label">留言</span></div>` : ''}
        ${p.shares ? `<div class="metric"><span class="metric-icon">🔗</span><span class="metric-val">${fmt(p.shares)}</span><span class="metric-label">分享</span></div>` : ''}
      </div>
      <div class="score-row">
